###############################################################################
# Makefile.datacosmos - aggregator-root PMM build and release helpers.
#
# This repository (pmm-submodules) is the build root. The exporter components
# (node_exporter, grafana, mysqld_exporter, ...) are real submodules under
# sources/*. The pmm and pmm-dump sources are NOT submodules: they are symlinks
# to the operator's live forks (apps/pmm, apps/pmm-dump) for local development.
#   sources/pmm      -> ../../../pmm       (datacosmos pmm fork, top-level go.mod)
#   sources/pmm-dump -> ../../../pmm-dump
# In CI (where only this repo is checked out) those symlinks dangle, so `dc-ci`
# MATERIALIZES them by cloning the pinned forks before building.
#
# The whole datacosmos cycle is just two operator verbs plus one CI verb:
#   make dc-validate   # unit-test both forks + source sanity (local gate)
#   make dc-release    # push forks to datacosmos-br + tag the release (triggers CI)
#   make dc-ci         # CI ONLY: materialize forks, build images+RPMs, push to GHCR
###############################################################################

SHELL := /bin/bash -o pipefail

# pmm / pmm-dump sources (symlinks locally, materialized clones in CI).
PMM_SRC              := sources/pmm
PMM_DUMP_SRC         := sources/pmm-dump
DC_PMM_REPO          ?= https://github.com/datacosmos-br/pmm.git
DC_PMM_REF           ?= feat/v3.8.0-dc
DC_PMM_REMOTE        ?= origin
DC_PMM_DUMP_REPO     ?= https://github.com/datacosmos-br/pmm-dump.git
DC_PMM_DUMP_REF      ?= v0.8.1-dc2
DC_PMM_DUMP_REMOTE   ?= origin

# Upstream stable base (e.g. 3.8.1), read from the pmm source. Lazy: resolved when
# a recipe runs (after the symlink/clone is present).
PMM_VERSION ?= $(shell git -C $(PMM_SRC) describe --tags --abbrev=0 \
	--match 'v[0-9]*.[0-9]*.[0-9]*' --exclude '*-dc*' 2>/dev/null | sed 's/^v//')

DIST          ?= el9
ROOT_DIR      ?= $(CURDIR)
ARTIFACT_DIR  ?= $(abspath $(CURDIR)/../pmm-artifacts)
GHCR_NAMESPACE ?= ghcr.io/datacosmos-br
GHCR_USER     ?=
DC_VERSION    ?= $(PMM_VERSION)-dev
IMAGE_ARCH    ?= amd64

# Files that carry datacosmos behavior and MUST be committed before dc-release.
DC_RELEASE_COMMIT_PATHS := \
	.gitmodules \
	Makefile.datacosmos \
	.github/workflows/datacosmos-release.yml \
	docs/datacosmos \
	AGENTS.md \
	CLAUDE.md

FULL_VERSION  = $(PMM_VERSION)-$(shell git rev-list --count HEAD)
CLIENT_IMAGE  ?= pmm-local/pmm-client:$(FULL_VERSION)
SERVER_IMAGE  ?= pmm-local/pmm-server:$(FULL_VERSION)
CLIENT_PUBLISH_IMAGE ?= $(GHCR_NAMESPACE)/pmm-client:$(DC_VERSION)-$(IMAGE_ARCH)
SERVER_PUBLISH_IMAGE ?= $(GHCR_NAMESPACE)/pmm-server:$(DC_VERSION)-$(IMAGE_ARCH)

export ROOT_DIR
export RPMBUILD_DIST := $(DIST)
unexport PUSH_DOCKER

# Next -dc tag from the aggregator's upstream sync position. Override with DC_RELEASE_TAG.
UPSTREAM_BRANCH ?= upstream/v3
define DC_RESOLVE_TAG_SCRIPT
if upstream_ref=$$(git rev-parse -q --verify MERGE_HEAD 2>/dev/null); then :; \
elif upstream_ref=$$(git merge-base HEAD $(UPSTREAM_BRANCH) 2>/dev/null); then :; \
else upstream_ref=$$(git rev-parse HEAD); fi; \
stable=$$(git -C $(PMM_SRC) tag --points-at HEAD --list 'v[0-9]*.[0-9]*.[0-9]*' 2>/dev/null | sed -n -E '/^v[0-9]+\.[0-9]+\.[0-9]+$$/p' | sort -V | sed -n '$$p'); \
if [ -n "$$stable" ]; then base="$${stable}-dc"; else base="v$(PMM_VERSION)-dc"; fi; \
last=$$(git tag -l "$${base}*" | sed -n "s/^$${base}\([0-9][0-9]*\)$$/\1/p" | sort -n | sed -n '$$p'); \
tag="$$base$$(( $${last:-0} + 1 ))"
endef

.PHONY: dc-help
dc-help: ## List datacosmos verbs
	@grep -E '^[a-zA-Z0-9_.-]+:.*?## ' $(lastword $(MAKEFILE_LIST)) | \
		awk -F ':.*?## ' '{printf "  %-14s%s\n", $$1, $$2}'

# ─────────────────────────────────────────────────────────────────────────────
# Operator verb 1: validate
# ─────────────────────────────────────────────────────────────────────────────
.PHONY: dc-validate
dc-validate: ## Unit-test pmm + pmm-dump forks and check source sanity (local gate)
	@rc=0; \
	for src in $(PMM_SRC) $(PMM_DUMP_SRC); do \
		if [ ! -f "$$src/go.mod" ]; then \
			echo "FAIL: $$src does not resolve to a go.mod tree (symlink broken?)"; rc=1; continue; fi; \
		echo "== tests: $$src =="; \
		( cd "$$src" && go build ./... && go vet ./... && go test ./... ) || rc=1; \
	done; \
	if git config -f $(PMM_SRC)/.gitmodules submodule.pmm-submodules.url >/dev/null 2>&1; then \
		echo "FAIL: $(PMM_SRC) declares a pmm-submodules back-ref (recursion not removed)"; rc=1; \
	else echo "OK: $(PMM_SRC) is de-recursed"; fi; \
	if [ $$rc -eq 0 ]; then echo "dc-validate: OK"; else echo "dc-validate: FAILED"; fi; \
	exit $$rc

# ─────────────────────────────────────────────────────────────────────────────
# Operator verb 2: release (publish forks + tag -> CI publishes images)
# ─────────────────────────────────────────────────────────────────────────────
.PHONY: dc-release
dc-release: .dc-clean-worktree .dc-fetch-tags ## Push forks to datacosmos-br + create/push the next -dc tag
	@echo "== publishing fork sources =="; \
	git -C $(PMM_SRC) push $(DC_PMM_REMOTE) $(DC_PMM_REF); \
	git -C $(PMM_DUMP_SRC) push $(DC_PMM_DUMP_REMOTE) $(DC_PMM_DUMP_REF); \
	if [ -n "$(DC_RELEASE_TAG)" ]; then tag="$(DC_RELEASE_TAG)"; else $(DC_RESOLVE_TAG_SCRIPT); fi; \
	git tag -a "$$tag" -m "datacosmos PMM $$tag (@ $$(git rev-parse --short HEAD))"; \
	git push origin "$$tag"; \
	printf "released %s (CI: datacosmos-release.yml builds + publishes amd64+arm64)\n" "$$tag"

# ─────────────────────────────────────────────────────────────────────────────
# CI verb (not for daily use): materialize forks, build, publish images to GHCR
# ─────────────────────────────────────────────────────────────────────────────
.PHONY: dc-ci
dc-ci: ## CI ONLY: clone pinned forks (if missing), build native images+RPMs, push to GHCR
	@for spec in "$(PMM_SRC)|$(DC_PMM_REPO)|$(DC_PMM_REF)" "$(PMM_DUMP_SRC)|$(DC_PMM_DUMP_REPO)|$(DC_PMM_DUMP_REF)"; do \
		path=$${spec%%|*}; rest=$${spec#*|}; repo=$${rest%%|*}; ref=$${rest##*|}; \
		if [ -f "$$path/go.mod" ]; then echo "OK: $$path already present (local symlink)"; continue; fi; \
		echo "materializing $$path from $$repo @ $$ref"; \
		rm -f "$$path"; \
		git clone --depth 1 --branch "$$ref" "$$repo" "$$path"; \
	done
	git submodule update --init --recursive --jobs 10
	mkdir -p $(ROOT_DIR)/tmp $(ROOT_DIR)/results $(ARTIFACT_DIR)
	chmod 0777 $(ROOT_DIR)/tmp $(ROOT_DIR)/results
	echo "$(PMM_VERSION)" > $(ROOT_DIR)/VERSION
	cd $(ROOT_DIR) && ROOT_DIR=$(ROOT_DIR) RPMBUILD_DIST=$(DIST) SKIP_S3_CACHE=1 \
		DOCKER_CLIENT_TAG=$(CLIENT_IMAGE) DOCKER_TAG=$(SERVER_IMAGE) \
		$(ROOT_DIR)/$(PMM_SRC)/build/scripts/build-server
	$(MAKE) -f Makefile.datacosmos .dc-artifacts
	$(MAKE) -f Makefile.datacosmos .dc-login
	docker tag $(CLIENT_IMAGE) $(CLIENT_PUBLISH_IMAGE)
	docker tag $(SERVER_IMAGE) $(SERVER_PUBLISH_IMAGE)
	docker push $(CLIENT_PUBLISH_IMAGE)
	docker push $(SERVER_PUBLISH_IMAGE)

# ─────────────────────────────────────────────────────────────────────────────
# Internal helpers (not user-facing)
# ─────────────────────────────────────────────────────────────────────────────
.PHONY: .dc-artifacts
.dc-artifacts:
	mkdir -p $(ARTIFACT_DIR)/server-rpms
	test -d $(ROOT_DIR)/results
	cp -a $(ROOT_DIR)/results/. $(ARTIFACT_DIR)/
	test -d $(ROOT_DIR)/tmp/pmm-server/RPMS
	rpm_count=$$(find $(ROOT_DIR)/tmp/pmm-server/RPMS -name '*.rpm' -type f | wc -l); \
	if [ "$$rpm_count" -eq 0 ]; then \
		echo "No server RPM artifacts found in $(ROOT_DIR)/tmp/pmm-server/RPMS"; \
		exit 1; \
	fi; \
	find $(ROOT_DIR)/tmp/pmm-server/RPMS -name '*.rpm' -type f \
		-exec cp -f {} $(ARTIFACT_DIR)/server-rpms/ \;
	echo "Artifacts in $(ARTIFACT_DIR)"

.PHONY: .dc-clean-worktree
.dc-clean-worktree:
	@if [ -n "$$(git status --porcelain -- $(DC_RELEASE_COMMIT_PATHS))" ]; then \
		echo "Release files have uncommitted changes; commit before dc-release"; \
		git status --short -- $(DC_RELEASE_COMMIT_PATHS); exit 1; fi

.PHONY: .dc-fetch-tags
.dc-fetch-tags:
	@git fetch --tags --quiet origin 2>/dev/null || true

.PHONY: .dc-login
.dc-login:
	@if [ -n "$$GITHUB_ACTIONS" ]; then \
		echo "$$GH_TOKEN" | docker login ghcr.io -u "$$GITHUB_ACTOR" --password-stdin; \
	elif [ -n "$$GHCR_TOKEN" ]; then \
		: "$${GHCR_USER:?set GHCR_USER for local ghcr.io login}"; \
		echo "$$GHCR_TOKEN" | docker login ghcr.io -u "$$GHCR_USER" --password-stdin; \
	else \
		: "$${GHCR_USER:?set GHCR_USER for local ghcr.io login}"; \
		gh auth token | docker login ghcr.io -u "$$GHCR_USER" --password-stdin; \
	fi
